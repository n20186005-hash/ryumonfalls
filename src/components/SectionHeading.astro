---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: "left" | "center";
}
const { eyebrow, title, text, align = "left" } = Astro.props;
---
<div class:list={["section-heading", align === "center" && "section-heading-center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {text && <p class="lead">{text}</p>}
</div>
