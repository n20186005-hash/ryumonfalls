---
import { place } from "@/data/place";
import { buildWeatherAdvice, dailyHints } from "@/lib/advice";
import {
  beaufort,
  formatPrecipitation,
  formatProbability,
  formatTemperature,
  formatUvIndex,
  formatWindLevel,
  formatWindSpeed
} from "@/lib/format";
import { describeCode, getForecast } from "@/lib/weather";

interface Props {
  variant?: "default" | "compact";
  forecastDays?: number;
  heading?: boolean;
}

const { variant = "default", forecastDays = variant === "compact" ? 4 : 7, heading = false } = Astro.props;

const forecast = await getForecast(place.latitude, place.longitude, forecastDays);
const visibleCount = variant === "compact" ? Math.min(4, forecastDays) : forecastDays;
const shownDays = (forecast?.days ?? []).slice(0, visibleCount);
const current = forecast?.current ?? null;
const today = shownDays[0];
const advice = buildWeatherAdvice(forecast);
const currentLabel = describeCode(current?.code ?? null);
const windLevel = beaufort(current?.windSpeed ?? today?.windSpeedMax ?? null);

const updatedText = forecast?.updatedAt
  ? new Intl.DateTimeFormat("ja-JP", {
      dateStyle: "long",
      timeStyle: "short",
      timeZone: "Asia/Tokyo"
    }).format(new Date(forecast.updatedAt))
  : null;
---

<section class="weather-card" data-weather data-lat={place.latitude} data-lng={place.longitude} data-days={forecastDays}>
  {heading ? <h3 class="weather-heading">{place.name}付近の現在の天気</h3> : null}

  {
    forecast ? (
      <div class="weather-body">
        <div class="weather-current">
          {updatedText ? <p class="weather-updated">{updatedText} 時点の観測・予報</p> : null}
          <div class="weather-now">
            <span class="weather-symbol" data-field="current-symbol" aria-hidden="true">{currentLabel.symbol}</span>
            <div>
              <p class="weather-temp" data-field="current-temp">{formatTemperature(current?.temperature ?? null)}</p>
              <p class="weather-desc" data-field="current-label">{currentLabel.label}</p>
            </div>
          </div>
          <dl class="weather-meta">
            <div><dt>体感</dt><dd data-field="current-apparent">{formatTemperature(current?.apparentTemperature ?? null)}</dd></div>
            <div><dt>湿度</dt><dd data-field="current-humidity">{formatProbability(current?.humidity ?? null)}</dd></div>
            <div><dt>風速</dt><dd data-field="current-wind">{formatWindSpeed(current?.windSpeed ?? null)}</dd></div>
            <div><dt>風の強さ</dt><dd data-field="current-wind-level">{formatWindLevel(windLevel)}</dd></div>
            <div><dt>降水量</dt><dd data-field="current-precip">{formatPrecipitation(current?.precipitation ?? null)}</dd></div>
            <div><dt>紫外線（最大）</dt><dd data-field="today-uv">{formatUvIndex(today?.uvIndexMax ?? null)}</dd></div>
          </dl>
        </div>

        <div class="weather-advice" data-advice-root>
          <p class="advice-summary" data-field="advice-summary">{advice?.summary}</p>

          <div class="advice-warning" data-block="warnings" hidden={!advice?.warnings.length}>
            <p class="advice-warning-title">予報値から見た注意ポイント</p>
            <ul data-slot="warnings">
              {advice?.warnings.map((text) => <li>{text}</li>)}
            </ul>
          </div>
          <p class="advice-safe" data-block="safe" hidden={Boolean(advice?.warnings.length)}>
            この予報値には強い危険サインは出ていません。大雨・大雪・台風の警報は出発前に必ずご確認ください。
          </p>

          <div class="advice-grid">
            <div class="advice-block" data-block="outfits" hidden={!advice?.outfits.length}>
              <p class="advice-block-title">服装の目安</p>
              <ul data-slot="outfits">
                {advice?.outfits.map((text) => <li>{text}</li>)}
              </ul>
            </div>
            <div class="advice-block" data-block="plans" hidden={!advice?.plans.length}>
              <p class="advice-block-title">滞在の組み立て方</p>
              <ul data-slot="plans">
                {advice?.plans.map((text) => <li>{text}</li>)}
              </ul>
            </div>
            <div class="advice-block" data-block="items" hidden={!advice?.items.length}>
              <p class="advice-block-title">あると助かる持ちもの</p>
              <ul data-slot="items">
                {advice?.items.map((text) => <li>{text}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="weather-body">
        <p class="weather-fallback">
          現在の天気を取得できませんでした。出発前に<a href="https://www.jma.go.jp/bosai/forecast/" target="_blank" rel="noopener noreferrer">気象庁の最新の天気・注意報<span aria-hidden="true">↗</span></a>と、このページ内の季節別の目安をご確認ください。
        </p>
      </div>
    )
  }

  {
    shownDays.length > 0 ? (
      <ul class="weather-days">
        {shownDays.map((day, index) => {
          const hints = dailyHints(day);
          return (
            <li class="weather-day" data-day={index}>
              <span class="weather-day-name">
                <strong data-field="label">{index === 0 ? "今日" : index === 1 ? "明日" : day.weekday}</strong>
                <small data-field="date">{day.date.replace(/^\d{4}-/, "")}</small>
              </span>
              <span class="weather-day-symbol" data-field="symbol" aria-hidden="true">{describeCode(day.code).symbol}</span>
              <span class="weather-day-desc">
                <span data-field="desc">{day.label}</span>
                {hints.length > 0 ? <small data-field="hints">{hints.join("／")}</small> : <small data-field="hints"></small>}
              </span>
              <span class="weather-day-range" data-field="range">{formatTemperature(day.max)} ／ {formatTemperature(day.min)}</span>
              <span class="weather-day-pop" data-field="pop">降水確率 {formatProbability(day.precipitationProbability)}</span>
            </li>
          );
        })}
      </ul>
    ) : null
  }

  <p class="note">
    気温・降水確率・紫外線はページを開いた時点の最新の観測・予報にもとづく値です。降水確率は「雨が降る可能性」であり、必ず降るという意味ではありません。台風・大雨・大雪の際は、必ず<a href="https://www.jma.go.jp/bosai/map.html" target="_blank" rel="noopener noreferrer">気象庁の防災情報<span aria-hidden="true">↗</span></a>と那須烏山市の案内をご確認ください。
  </p>
</section>

<script>
  import { startForecastRefresh } from "../scripts/weather";

  startForecastRefresh();
</script>
